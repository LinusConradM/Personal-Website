---
import Base from '../layouts/Base.astro';

const email = 'linusconradm@gmail.com';
const github = 'https://github.com/LinusConradM';
const linkedin = 'https://www.linkedin.com/in/Conrad-Linus-m';
const scorecardLive = 'https://wbg-scorecard-529644724770.us-east4.run.app';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Conrad Linus Muhirwe',
  url: 'https://conradlinusmuhirwe.netlify.app/',
  image: 'https://conradlinusmuhirwe.netlify.app/images/conrad-linus-muhirwe.jpg',
  jobTitle: 'Data Scientist and AI Engineer',
  worksFor: { '@type': 'CollegeOrUniversity', name: 'American University' },
  address: { '@type': 'PostalAddress', addressLocality: 'Washington', addressRegion: 'DC', addressCountry: 'US' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'American University' },
    { '@type': 'CollegeOrUniversity', name: 'Uganda Martyrs University' },
  ],
  sameAs: [linkedin, github],
};

const moreWork = [
  {
    kind: 'Data pipeline',
    title: 'US Food Insecurity Atlas',
    text: 'US food insecurity from 2001 to 2024, by nation, state and county, from USDA, Feeding America’s Map the Meal Gap and the Census. A daily pipeline runs about 40 validation checks and publishes only when they pass, and every figure shows its source, its release date, and a margin of error where the source publishes one.',
    links: [
      { label: 'Live site', href: 'https://linusconradm.github.io/feeding_america/' },
      { label: 'Code', href: 'https://github.com/LinusConradM/feeding_america' },
    ],
  },
  {
    kind: 'Agent',
    title: 'Job Tracker and Daily Digest',
    text: 'An agent on GitHub Actions that searches 50+ sources each day, including 9 ATS platforms and Workday’s JSON API, scores every role against a résumé with Claude, and emails only the roles it scores 8 or higher out of 10.',
    links: [],
  },
  {
    kind: 'Voice and chat',
    title: 'Planit',
    text: 'WhatsApp appointment booking for East African businesses, by text or voice note in Luganda, Runyankore, Kiswahili, Kinyarwanda or English. A LangGraph state machine with live Google Calendar availability.',
    links: [{ label: 'Project page', href: 'https://linusconradm.github.io/planit/' }],
  },
  {
    kind: 'Internship',
    title: 'Federal Financial Reporting',
    text: 'At Revolutional (formerly Harmonia Holdings Group): AI validation, compliance checks and audit trails for a federal reporting app on AWS, cutting manual processing by 80%. Proprietary, so there is no public link.',
    links: [],
  },
];

const roles = [
  { years: 'Sep 2026 – now', role: 'Power BI Analyst', org: 'American University' },
  { years: 'Feb – Aug 2026', role: 'Research Associate', org: 'Institute on Disability and Public Policy' },
  { years: 'Aug 2025 – Jan 2026', role: 'Event Data Coordinator', org: 'American University' },
  { years: 'Jun – Aug 2025', role: 'Software / Data Analyst Intern', org: 'Revolutional' },
  { years: 'Jan – Jun 2025', role: 'Graduate Assistant, Research and Teaching', org: 'American University' },
  { years: 'Jun 2023 – Jul 2024', role: 'Senior Internal Auditor', org: 'Uganda Development Bank' },
  { years: 'Dec 2021 – May 2023', role: 'Business Compliance Advisory Manager', org: 'Stanbic Bank Uganda' },
  { years: 'Dec 2012 – Nov 2021', role: 'Internal Auditor to Manager, Internal Audit', org: 'Equity Bank Uganda' },
];
---
<Base
  title="Conrad Linus Muhirwe, data scientist and AI engineer"
  description="Data scientist and AI engineer in Washington, DC. I build AI systems that show their work: answers traced to the query, citations to the passage, and a person signing off where it matters."
  jsonLd={jsonLd}
>
  <section class="hero dots" aria-labelledby="hero-title">
    <div class="wrap">
      <div class="hero-id">
        <img
          class="portrait"
          src="/images/conrad-linus-muhirwe-320.webp"
          width="320" height="320"
          alt="Portrait of Conrad Linus Muhirwe"
        />
        <p class="label">Data scientist and AI engineer <span aria-hidden="true">/</span> Washington, DC</p>
      </div>
      <h1 id="hero-title" class="display">I build AI systems that <span class="hl">show their work.</span></h1>
      <div class="hero-row">
        <p class="hero-lede">
          I spent more than ten years in bank audit and compliance, where every number had to trace back to a source.
          Now I build LLM applications held to the same rule: answers tied to the query that produced them, citations
          to the passage, and a person signing off where it matters.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href="#work">See the work</a>
          <a class="btn btn-outline" href={`mailto:${email}`}>Get in touch</a>
        </div>
      </div>

      <figure class="trace" aria-labelledby="trace-cap">
        <figcaption id="trace-cap" class="trace-cap label">
          <span><span class="trace-dot" aria-hidden="true"></span>One real answer from Scorecard Explorer, traced</span>
          <span>FY2026 edition · DuckDB</span>
        </figcaption>
        <ol class="trace-steps" role="list">
          <li class="step s1">
            <span class="step-label">01 Question</span>
            <p class="step-q">How many people have gained electricity access through active World Bank Group projects?</p>
          </li>
          <li class="wire w1" aria-hidden="true"></li>
          <li class="step s2">
            <span class="step-label">02 Query, checked by the parser</span>
<pre class="step-sql"><code><b>SELECT</b> achieved, expected
<b>FROM</b> wbg_results_wide
<b>WHERE</b> ind_code = 'CSC_RES_ELC_ACCS'
  AND snapshot_fy = 2026
  AND ref_area_type = 'WORLD'</code></pre>
          </li>
          <li class="wire w2" aria-hidden="true"></li>
          <li class="step s3">
            <span class="step-label">03 Row returned</span>
            <dl class="step-row">
              <div><dt>achieved</dt><dd class="hit">258.4M</dd></div>
              <div><dt>expected</dt><dd>511.7M</dd></div>
            </dl>
          </li>
          <li class="wire w3" aria-hidden="true"></li>
          <li class="step s4 step-answer">
            <span class="step-label">04 Answer, numbers checked</span>
            <p class="step-a"><mark>258.4 million people</mark> have gained access, 50.5% of the <u>511.7 million</u> expected.</p>
            <span class="step-ok">2 of 2 figures match the row</span>
          </li>
        </ol>
      </figure>
    </div>
  </section>

  <section class="proof" aria-label="At a glance">
    <ul class="wrap proof-grid" role="list">
      <li><span class="proof-n">12/12</span><span class="proof-t">questions right in the Scorecard grounding eval</span></li>
      <li><span class="proof-n">$0.0018</span><span class="proof-t">per query, about a twentieth of the Sonnet cost</span></li>
      <li><span class="proof-n">WCAG 2.2</span><span class="proof-t">AA on every public build, checked with axe</span></li>
      <li><span class="proof-n">10+ yrs</span><span class="proof-t">in bank audit and compliance</span></li>
    </ul>
  </section>

  <section id="work" class="wrap work" aria-labelledby="work-title">
    <div class="section-head">
      <h2 id="work-title" class="display">Selected work</h2>
      <span class="label">3 case studies · 4 more below</span>
    </div>

    <article class="exhibit" aria-labelledby="case-1">
      <div class="ex-text">
        <span class="numeral" aria-hidden="true">01</span>
        <p class="label ex-kicker">Independent build · 2026</p>
        <h3 id="case-1" class="display"><a href="/work/scorecard-explorer">Scorecard Explorer</a></h3>
        <p class="ex-lede">Ask the World Bank Group Corporate Scorecard a question in plain English. Every number in the answer is checked against the rows its query returned.</p>
        <ul class="points">
          <li><strong>SQL guard at the parser.</strong> DuckDB’s own parser allows one read-only SELECT on allow-listed tables, with a row cap and a timeout.</li>
          <li><strong>Number traceability.</strong> A figure that does not match a returned row is marked “Not checked” instead of shown as fact.</li>
        </ul>
        <p class="stack">Claude Haiku · DuckDB · FastAPI · React · FAISS · Cloud Run</p>
        <p class="ex-links">
          <a class="btn btn-primary" href="/work/scorecard-explorer">Read the case study</a>
          <a class="btn btn-outline" href={scorecardLive} rel="noopener">Open the live app</a>
        </p>
      </div>
      <figure class="ex-figure">
        <div class="shot">
          <img
            src="/images/work/scorecard-landing-1600.webp"
            srcset="/images/work/scorecard-landing-800.webp 800w, /images/work/scorecard-landing-1600.webp 1600w"
            sizes="(max-width: 760px) 100vw, 700px"
            width="1600" height="1000"
            loading="lazy"
            alt="Scorecard Explorer landing page. Headline: 258.4 million people have gained electricity access through active World Bank Group projects, shown as a bar at 50.5 percent of the 511.7 million expected, with an Ask the Scorecard box below."
          />
        </div>
        <p class="pin pin-a"><span class="label">Grounding eval</span><strong>12 of 12 correct</strong></p>
        <p class="pin pin-b"><span class="label">Cost per query</span><strong>$0.0018</strong></p>
        <figcaption>The live landing page, FY2026 edition. The headline is a query result, not copy.</figcaption>
      </figure>
    </article>

    <article class="exhibit exhibit-flip" aria-labelledby="case-2">
      <div class="ex-text">
        <span class="numeral" aria-hidden="true">02</span>
        <p class="label ex-kicker">Institute on Disability and Public Policy · 2026</p>
        <h3 id="case-2" class="display"><a href="/work/crpd-dashboard">CRPD Disability Rights Dashboard</a></h3>
        <p class="ex-lede">The full UN Convention on the Rights of Persons with Disabilities reporting cycle, searchable and cited, for advocates, governments and researchers. Built for the June 2026 Conference of States Parties.</p>
        <ul class="points">
          <li><strong>RAG over the treaty corpus.</strong> all-mpnet-base-v2 embeddings in FAISS; Claude Haiku answers with inline citations.</li>
          <li><strong>Accessibility is the subject.</strong> Articles 9 and 21 require accessible information, so WCAG 2.2 AA is audited with Playwright and axe.</li>
        </ul>
        <p class="stack">Python · Streamlit · FAISS · Claude · Plotly · Posit Connect</p>
        <p class="ex-links">
          <a class="btn btn-primary" href="/work/crpd-dashboard">Read the case study</a>
          <a class="btn btn-outline" href="https://crpd.idppglobal.org/" rel="noopener">crpd.idppglobal.org</a>
        </p>
      </div>
      <figure class="ex-figure">
        <div class="panel">
          <div class="panel-head">
            <span class="big-number display">17</span>
            <span class="panel-sub">interactive views over the UN treaty reporting record, in three groups</span>
          </div>
          <div class="groups">
            <div>
              <p class="group-title">Explore</p>
              <ul><li>Choropleth maps</li><li>Reporting timelines</li><li>Country profiles</li><li>Document comparison</li><li>Semantic search</li></ul>
            </div>
            <div>
              <p class="group-title">Analyze</p>
              <ul><li>Article coverage</li><li>Co-occurrence</li><li>Medical vs rights-based language shift</li></ul>
            </div>
            <div class="group-accent">
              <p class="group-title">AI-powered</p>
              <ul><li>Research Assistant</li><li>Policy Brief Generator</li><li>Both cite their sources inline</li></ul>
            </div>
          </div>
        </div>
        <figcaption>How the platform is organized.</figcaption>
      </figure>
    </article>

    <article class="exhibit" aria-labelledby="case-3">
      <div class="ex-text">
        <span class="numeral" aria-hidden="true">03</span>
        <p class="label ex-kicker">Independent build · 2026</p>
        <h3 id="case-3" class="display"><a href="/work/contract-review">Contract Review Agent</a></h3>
        <p class="ex-lede">Reads a contract, analyzes every clause for legal risk in parallel, then stops and waits for a person to approve before any memo is sent.</p>
        <ul class="points">
          <li><strong>Durable by design.</strong> Each stage is a checkpointed task, so a crash or redeploy resumes where it stopped, with no lost or duplicated work.</li>
          <li><strong>Provider-agnostic.</strong> One call routes across Groq, Gemini, OpenRouter, OpenAI and Anthropic with key-driven fallback.</li>
        </ul>
        <p class="stack">Next.js 15 · Trigger.dev · Postgres · Prisma · Cloudflare R2</p>
        <p class="ex-links">
          <a class="btn btn-primary" href="/work/contract-review">Read the case study</a>
          <a class="btn btn-outline" href="https://contract-review-pied.vercel.app" rel="noopener">Live app</a>
          <a class="btn btn-outline" href="https://github.com/LinusConradM/contract_review" rel="noopener">Code</a>
        </p>
      </div>
      <figure class="ex-figure">
        <div class="panel">
          <p class="label">One run, start to finish</p>
          <ol class="steps">
            <li><span class="step-n">01</span><span>Extract text from the PDF or Word file</span></li>
            <li><span class="step-n">02</span><span>Split it into clauses</span></li>
            <li><span class="step-n">03</span><span>Analyze each clause as its own child run, throttled to provider rate limits</span></li>
            <li class="step-key"><span class="step-n">04</span><span><strong>Wait for a reviewer.</strong> The run suspends and frees its compute for minutes or weeks, then resumes on approval.</span></li>
            <li><span class="step-n">05</span><span>Write the memo, stream it to the page, email it</span></li>
          </ol>
        </div>
        <figcaption>Step 4 is the point of the project: nothing leaves without a person’s sign-off.</figcaption>
      </figure>
    </article>

    <div class="section-head more-head">
      <h2 class="display">More work</h2>
    </div>
    <ul class="rows" role="list">
      {moreWork.map((w) => (
        <li class="row">
          <span class="label">{w.kind}</span>
          <h3 class="row-title">{w.title}</h3>
          <div>
            <p class="row-text">{w.text}</p>
            {w.links.length > 0 && (
              <p class="row-links">
                {w.links.map((l) => <a href={l.href} rel="noopener">{l.label}<span class="sr-only">: {w.title}</span></a>)}
              </p>
            )}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section id="experience" class="experience" aria-labelledby="exp-title">
    <div class="wrap">
      <h2 id="exp-title" class="display">A decade of checking numbers. Then systems that check them.</h2>
      <p class="exp-lede">Audit and compliance at three banks in Uganda, then a move to Washington for graduate study in AI.</p>

      <ol class="timeline" role="list" aria-label="Career at a glance">
        <li><span class="node" aria-hidden="true"></span><span class="label">2012 · Kampala</span><span class="tl-org">Equity Bank Uganda</span><span class="tl-text">Internal Auditor to Manager, Internal Audit</span></li>
        <li><span class="node" aria-hidden="true"></span><span class="label">2021</span><span class="tl-org">Stanbic Bank Uganda</span><span class="tl-text">Business Compliance Advisory Manager</span></li>
        <li><span class="node" aria-hidden="true"></span><span class="label">2023</span><span class="tl-org">Uganda Development Bank</span><span class="tl-text">Senior Internal Auditor</span></li>
        <li class="tl-now"><span class="node" aria-hidden="true"></span><span class="label">2025 · Washington, DC</span><span class="tl-org">American University</span><span class="tl-text">MS in Analytics and AI, then research and analytics roles</span></li>
      </ol>

      <div class="exp-detail">
        <ul class="roles" role="list">
          {roles.map((r) => (
            <li>
              <span class="label">{r.years}</span>
              <span class="role">{r.role}</span>
              <span class="org">{r.org}</span>
            </li>
          ))}
        </ul>
        <div class="edu-col">
          <p class="edu">
            <strong>Education.</strong> MS in Analytics and Artificial Intelligence, and Graduate Certificate in Data Science,
            American University, 2026. BBA in Finance and Accounting, Uganda Martyrs University, 2011.
          </p>
          <p class="edu"><strong>Certifications.</strong> <a href="https://www.coursera.org/account/accomplishments/specialization/T6XEQGVXB7R4" rel="noopener">IBM Data Science</a>, <a href="https://credentials.corporatefinanceinstitute.com/68664647-7852-47f7-9a55-50289335bd37" rel="noopener">CFI FMVA</a>, <a href="https://credentials.corporatefinanceinstitute.com/f4890a5f-3502-410a-9592-d21952d2b9a6" rel="noopener">CFI BIDA</a>.</p>
          <p class="edu"><a href="https://flowcv.com/resume/gm2mwats01sh" rel="noopener">Full résumé</a></p>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="contact dots" aria-labelledby="contact-title">
    <div class="wrap">
      <p class="label contact-kicker">Hiring for data science or AI engineering?</p>
      <h2 id="contact-title" class="display">Let’s talk.</h2>
      <a class="contact-email" href={`mailto:${email}`}>{email}</a>
      <div class="actions">
        <a class="btn btn-outline" href={linkedin} rel="me noopener">LinkedIn</a>
        <a class="btn btn-outline" href={github} rel="me noopener">GitHub</a>
        <a class="btn btn-outline" href="https://flowcv.com/resume/gm2mwats01sh" rel="noopener">Résumé</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { border-bottom: 1px solid var(--line); padding: 104px 0 96px; }
  .hero-id { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
  .portrait { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 1px var(--line-strong), 0 0 0 4px var(--bg); }
  .hero-id .label { color: var(--ink-3); }
  .hero-id .label span { color: var(--line-strong); margin: 0 6px; }
  .hero h1 {
    margin-top: 36px;
    font-size: clamp(46px, 8.6vw, 116px);
    line-height: 0.96;
    letter-spacing: -0.05em;
    font-weight: 700;
    max-width: 1100px;
  }
  .hl { color: var(--accent); }
  .hero-row { margin-top: 44px; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 32px 64px; }
  .hero-lede { max-width: 640px; font-size: 20px; line-height: 1.6; color: var(--ink-2); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .actions .btn { min-height: 52px; padding: 0 26px; font-size: 16px; }

  .trace { margin-top: 88px; }
  .trace-cap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; margin: 0 0 16px; }
  .trace-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--gold); margin-right: 10px; vertical-align: 1px; }
  .trace-steps {
    list-style: none; padding: 0; margin: 0;
    display: flex; align-items: stretch;
    border-radius: 20px;
    background: var(--bg-raised);
    box-shadow: 0 0 0 1px var(--line), 0 40px 100px -60px var(--glow);
    overflow: hidden;
  }
  .step { flex: 1 1 0; min-width: 0; padding: 28px; display: flex; flex-direction: column; gap: 14px; }
  .s2 { flex-grow: 1.5; }
  .s4 { flex-grow: 1.3; }
  .step-label { font-family: var(--mono); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .step-q, .step-a { font-size: 18px; line-height: 1.45; color: var(--ink); }
  .step-sql { margin: 0; font-family: var(--mono); font-size: 13px; line-height: 1.7; color: var(--ink-2); white-space: pre-wrap; }
  .step-sql b { font-weight: 500; color: var(--accent); }
  .step-row { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; font-family: var(--mono); font-size: 13px; }
  .step-row dt { color: var(--muted); margin-bottom: 8px; }
  .step-row dd { margin: 0; padding: 10px; border-radius: 8px; box-shadow: 0 0 0 1px var(--line-strong); color: var(--ink); }
  .step-row dd.hit { background: var(--accent-wash); box-shadow: 0 0 0 1px var(--gold); font-weight: 500; }
  .step-answer { background: var(--bg-subtle); }
  .step-a mark { background: none; color: var(--accent); font-weight: 700; text-decoration: underline; text-decoration-color: var(--gold); text-underline-offset: 5px; }
  .step-a u { text-decoration-color: var(--line-strong); text-underline-offset: 5px; }
  .step-ok { font-family: var(--mono); font-size: 12px; color: var(--accent); }
  .wire { flex: 0 0 36px; align-self: center; height: 1px; background: var(--gold); transform-origin: left center; }

  @media (prefers-reduced-motion: no-preference) {
    .step { animation: rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
    .s2 { animation-delay: 0.7s; } .s3 { animation-delay: 1.4s; } .s4 { animation-delay: 2.1s; }
    .wire { animation: draw 0.5s ease-out both; }
    .w1 { animation-delay: 0.45s; } .w2 { animation-delay: 1.15s; } .w3 { animation-delay: 1.85s; }
    .hit { animation: glow 1.6s ease-in-out 2.6s 2; }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @keyframes draw { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes glow { 50% { box-shadow: 0 0 0 1px var(--gold), 0 0 24px var(--glow); } }

  .proof { border-bottom: 1px solid var(--line); }
  .proof-grid { list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .proof-grid li { padding: 36px 24px; display: flex; flex-direction: column; gap: 6px; border-left: 1px solid var(--line); }
  .proof-grid li:first-child { border-left: 0; padding-left: 0; }
  .proof-n { font-size: clamp(30px, 3.6vw, 44px); font-weight: 700; letter-spacing: -0.04em; line-height: 1.1; }
  .proof-t { font-size: 14px; color: var(--muted); }

  .work { padding-top: 128px; }
  .section-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px 24px; }
  .section-head h2 { font-size: clamp(40px, 6vw, 72px); line-height: 1; letter-spacing: -0.045em; }

  .exhibit {
    position: relative;
    margin-top: 120px;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 56px;
    align-items: start;
  }
  .exhibit:first-of-type { margin-top: 80px; }
  .exhibit-flip { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .exhibit-flip .ex-text { order: 2; }
  .exhibit-flip .ex-figure { order: 1; }
  .numeral {
    display: block;
    font-size: clamp(88px, 10vw, 136px);
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--gold);
    user-select: none;
    margin-bottom: 8px;
  }
  .ex-text, .ex-figure { position: relative; }
  .ex-text { display: flex; flex-direction: column; gap: 20px; }
  .ex-kicker { color: var(--accent); }
  .ex-text h3 { font-size: clamp(32px, 3.8vw, 48px); line-height: 1.04; }
  .ex-text h3 a { color: var(--ink); text-decoration: none; }
  .ex-text h3 a:hover { text-decoration: underline; text-decoration-color: var(--gold); text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .ex-lede { font-size: 18px; line-height: 1.6; color: var(--ink-2); }
  .points { padding-left: 1.1em; display: flex; flex-direction: column; gap: 10px; font-size: 15px; line-height: 1.6; color: var(--ink-3); }
  .points strong { color: var(--ink); font-weight: 700; }
  .stack { font-family: var(--mono); font-size: 13px; line-height: 1.8; color: var(--muted); }
