---
import Base from './Base.astro';

interface Meta { label: string; value: string; href?: string }
interface Next { href: string; title: string }

interface Props {
  title: string;
  description: string;
  kicker: string;
  headline: string;
  meta: Meta[];
  links: { label: string; href: string }[];
  ogImage?: string;
  next: Next;
}

const { title, description, kicker, headline, meta, links, ogImage, next } = Astro.props;
---
<Base title={title} description={description} image={ogImage} type="article">
  <article>
    <header class="wrap cs-head">
      <p class="label">{kicker}</p>
      <h1 class="serif">{headline}</h1>
      <dl class="cs-meta">
        {meta.map((m) => (
          <div>
            <dt class="label">{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))}
        <div>
          <dt class="label">Links</dt>
          <dd class="cs-links">
            {links.map((l) => <a href={l.href} rel="noopener">{l.label}</a>)}
          </dd>
        </div>
      </dl>
    </header>

    <slot name="hero" />

    <div class="wrap cs-body">
      <slot />
    </div>

    <nav aria-label="More case studies" class="wrap">
      <div class="cs-next">
      <a href="/#work">
        <span class="label">All work</span>
        <span class="cs-next-title">Back to the home page</span>
      </a>
      <a href={next.href} class="cs-next-right">
        <span class="label">Next case study</span>
        <span class="cs-next-title serif">{next.title}</span>
      </a>
      </div>
    </nav>
  </article>
</Base>

<style>
  .cs-head { padding-top: 88px; }
  .cs-head h1 {
    margin-top: 24px;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.08;
    max-width: 920px;
  }
  .cs-meta {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin: 48px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .cs-meta dd { margin: 6px 0 0; font-size: 15px; }
  .cs-links { display: flex; flex-wrap: wrap; gap: 0 16px; }

  .cs-body { padding-bottom: 32px; }

  .cs-next {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 24px;
    margin-top: 72px;
    margin-bottom: 96px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }
  .cs-next a { color: var(--ink); text-decoration: none; display: flex; flex-direction: column; gap: 6px; padding: 4px 0; }
  .cs-next a:hover .cs-next-title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .cs-next-right { text-align: right; align-items: flex-end; }
  .cs-next-title { font-size: 20px; }

  :global(.cs-figure) { margin-top: 64px; }
  :global(.cs-section) {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 48px;
    padding-top: 72px;
  }
  :global(.cs-section > .label) { padding-top: 8px; }
  :global(.cs-prose) { max-width: 680px; }
  :global(.cs-prose h2) { font-family: var(--serif); font-weight: 500; font-size: 30px; line-height: 1.2; letter-spacing: -0.01em; margin-bottom: 16px; }
  :global(.cs-prose p), :global(.cs-prose li) { font-size: 18px; line-height: 1.65; color: var(--ink-2); }
  :global(.cs-prose p + p) { margin-top: 18px; }
  :global(.cs-prose ul), :global(.cs-prose ol) { padding-left: 1.2em; margin-top: 18px; display: flex; flex-direction: column; gap: 10px; }
  :global(.cs-prose strong) { color: var(--ink); font-weight: 600; }
  :global(.cs-note) { font-size: 14px; line-height: 1.6; color: var(--muted); margin-top: 14px; max-width: 680px; }

  :global(.table-box) { overflow-x: auto; margin-top: 24px; }
  :global(.table-box table) { border-collapse: collapse; width: 100%; font-size: 14px; }
  :global(.table-box caption) { text-align: left; font-size: 14px; color: var(--muted); padding-bottom: 12px; }
  :global(.table-box th) { text-align: left; font-weight: 500; color: var(--muted); padding: 10px 12px; border-bottom: 1px solid var(--rule); white-space: nowrap; }
  :global(.table-box td) { padding: 12px; border-bottom: 1px solid var(--line); white-space: nowrap; }
  :global(.table-box .num) { text-align: right; font-variant-numeric: tabular-nums; }
  :global(.table-box .chosen) { background: var(--accent-wash); }
  :global(.table-box .chosen td:first-child strong) { font-weight: 600; }

  @media (max-width: 760px) {
    .cs-head { padding-top: 48px; }
    .cs-meta { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cs-next-right { text-align: left; align-items: flex-start; }
    :global(.cs-section) { grid-template-columns: minmax(0, 1fr); gap: 12px; padding-top: 48px; }
    :global(.cs-prose h2) { font-size: 25px; }
    :global(.cs-prose p), :global(.cs-prose li) { font-size: 17px; }
    :global(.cs-figure) { margin-top: 40px; }
  }
</style>
